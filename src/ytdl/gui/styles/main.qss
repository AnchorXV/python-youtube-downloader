/* ─── Base ─────────────────────────────────────── */
QWidget {
    background-color: #111319;
    color: #e1e2ea;
    font-family: "Plus Jakarta Sans", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #111319;
}

/* ─── Labels ───────────────────────────────────── */
QLabel {
    background-color: transparent;
    color: #e1e2ea;
}

QLabel#titleLabel {
    font-size: 22px;
    font-weight: 600;
    color: #adc6ff;
    padding: 4px;
}

QLabel#videoTitle {
    font-size: 15px;
    font-weight: 600;
    color: #e1e2ea;
}

QLabel#metaLabel {
    font-size: 12px;
    color: #c1c6d7;
}

QLabel#thumbnailPlaceholder {
    background-color: #0b0e13;
    border: 1px solid #414755;
    border-radius: 8px;
    color: #8b90a0;
    font-size: 11px;
}

/* ─── Buttons ──────────────────────────────────── */
QPushButton#primaryButton {
    background-color: #4b8eff;
    color: #ffffff;
    border: 1px solid #adc6ff;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #adc6ff;
    color: #002e69;
}

QPushButton#primaryButton:pressed {
    background-color: #005bc1;
}

QPushButton#primaryButton:disabled {
    background-color: #272a30;
    color: #8b90a0;
    border-color: #414755;
}

QPushButton#ghostButton {
    background-color: rgba(255, 255, 255, 0.06);
    color: #e1e2ea;
    border: 1px solid #414755;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton#ghostButton:hover {
    border-color: #adc6ff;
    background-color: rgba(173, 198, 255, 0.1);
}

/* ─── Input fields ─────────────────────────────── */
QLineEdit {
    background-color: #0b0e13;
    color: #e1e2ea;
    border: 1px solid #414755;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #4b8eff;
}

QLineEdit:focus {
    border: 1px solid #adc6ff;
}

/* ─── Group boxes ──────────────────────────────── */
QGroupBox {
    background-color: #1d2025;
    border: 1px solid #414755;
    border-radius: 12px;
    margin-top: 14px;
    padding: 16px;
    font-size: 12px;
    font-weight: 600;
    color: #adc6ff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    color: #adc6ff;
    background-color: #111319;
}

/* ─── Progress bar ─────────────────────────────── */
QProgressBar {
    background-color: #0b0e13;
    border: 1px solid #414755;
    border-radius: 8px;
    text-align: center;
    color: #e1e2ea;
    height: 22px;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #4b8eff;
    border-radius: 7px;
}

/* ─── Text edit (log) ──────────────────────────── */
QPlainTextEdit {
    background-color: #0b0e13;
    color: #c1c6d7;
    border: 1px solid #414755;
    border-radius: 8px;
    padding: 8px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 12px;
    selection-background-color: #4b8eff;
}

/* ─── Combo box ────────────────────────────────── */
QComboBox {
    background-color: #1d2025;
    color: #e1e2ea;
    border: 1px solid #414755;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #adc6ff;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1d2025;
    color: #e1e2ea;
    border: 1px solid #414755;
    selection-background-color: #4b8eff;
    selection-color: #ffffff;
    outline: none;
}

/* ─── Radio buttons ────────────────────────────── */
QRadioButton {
    color: #e1e2ea;
    font-size: 13px;
    padding: 4px;
    spacing: 6px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #414755;
    background-color: #0b0e13;
}

QRadioButton::indicator:checked {
    border: 2px solid #adc6ff;
    background-color: #4b8eff;
}

QRadioButton::indicator:hover {
    border-color: #8b90a0;
}

/* ─── Splitter ─────────────────────────────────── */
QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:hover {
    background-color: #414755;
}

/* ─── Scrollbar ────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #414755;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #8b90a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}