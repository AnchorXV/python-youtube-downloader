/* ─── Base ─────────────────────────────────────── */
QWidget {
    background-color: #111319;
    color: #e1e2ea;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #111319;
}

/* ─── Labels ───────────────────────────────────── */
QLabel {
    background-color: transparent;
    color: #e1e2ea;
}

QLabel#titleLabel {
    font-size: 24px;
    font-weight: 600;
    color: #adc6ff;
    padding: 8px;
}

QLabel#subtitleLabel {
    font-size: 14px;
    color: #c1c6d7;
    padding: 4px;
}

/* ─── Buttons (primary) ────────────────────────── */
QPushButton {
    background-color: #4b8eff;
    color: #ffffff;
    border: 1px solid #adc6ff;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #adc6ff;
    color: #002e69;
}

QPushButton:pressed {
    background-color: #005bc1;
}

QPushButton:disabled {
    background-color: #272a30;
    color: #8b90a0;
    border-color: #414755;
}

/* ─── Input fields ─────────────────────────────── */
QLineEdit {
    background-color: #0b0e13;
    color: #e1e2ea;
    border: 1px solid #414755;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #4b8eff;
}

QLineEdit:focus {
    border: 1px solid #adc6ff;
}

QLineEdit::placeholder {
    color: #8b90a0;
}

/* ─── Group boxes ──────────────────────────────── */
QGroupBox {
    background-color: #1d2025;
    border: 1px solid #414755;
    border-radius: 12px;
    margin-top: 12px;
    padding: 16px;
    font-size: 13px;
    font-weight: 600;
    color: #adc6ff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    color: #adc6ff;
}

/* ─── Progress bar ─────────────────────────────── */
QProgressBar {
    background-color: #0b0e13;
    border: 1px solid #414755;
    border-radius: 8px;
    text-align: center;
    color: #e1e2ea;
    height: 24px;
}

QProgressBar::chunk {
    background-color: #4b8eff;
    border-radius: 7px;
}

/* ─── Text edit (log) ──────────────────────────── */
QPlainTextEdit, QTextEdit {
    background-color: #0b0e13;
    color: #c1c6d7;
    border: 1px solid #414755;
    border-radius: 8px;
    padding: 8px;
    font-family: "Consolas", monospace;
    font-size: 12px;
}

/* ─── Combo box ────────────────────────────────── */
QComboBox {
    background-color: #1d2025;
    color: #e1e2ea;
    border: 1px solid #414755;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #adc6ff;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1d2025;
    color: #e1e2ea;
    border: 1px solid #414755;
    selection-background-color: #4b8eff;
    selection-color: #ffffff;
}

/* ─── Scrollbar ────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #414755;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #8b90a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}